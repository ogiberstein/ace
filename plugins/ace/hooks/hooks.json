{
  "description": "ACE plugin hooks. SessionStart emits standing instructions per spec §6.3.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ace-session-start.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
