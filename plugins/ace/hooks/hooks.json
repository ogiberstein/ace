{
  "description": "ACE plugin hooks. SessionStart emits standing instructions per spec §6.3; Stop emits the bounded capture nudge.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ace-session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ace-stop-capture-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
